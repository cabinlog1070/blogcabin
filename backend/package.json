{
  "name": "blogcabin-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=../frontend/.env.local src/index.ts",
    "build": "rm -rf dist && esbuild src/index.ts scripts/migrate.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs",
    "start": "node --conditions=react-server dist/src/index.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.10.0",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
