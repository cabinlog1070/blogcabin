  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
