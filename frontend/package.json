    "test:release-notes": "tsx scripts/test-release-notes.ts",
    "test:status-message": "tsx scripts/test-status-message.ts",
    "test": "npm run test:game && npm run test:shop && npm run test:ids && npm run test:status-message && npm run test:rules && npm run test:release-notes && npm run test:sanitize && npm run test:i18n"
